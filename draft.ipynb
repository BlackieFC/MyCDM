   "source": [
    "#### 单行&去重"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import itertools\n",
    "import os\n",
    "\n",
    "\n",
    "# 任务1：处理Excel文件\n",
    "def process_excel(input_file, output_file, sheet_name=\"diff-v2\"):\n",
    "    # 读取Excel文件\n",
    "    df = pd.read_excel(input_file, sheet_name=sheet_name)\n",
    "    \n",
    "    # 新增D列，C列<0.4的值加0.1，其余不变\n",
    "    df['D'] = df['C'].apply(lambda x: x + 0.1 if x < 0.4 else x)\n",
    "    \n",
    "    # 新增E列，B列的值乘以0.2\n",
    "    df['E'] = df['B'] * 0.2\n",
    "    \n",
    "    # 保存修改后的dataframe到新的xlsx文件\n",
    "    df.to_excel(output_file, index=False)\n",
    "    \n",
    "    return df\n",
    "\n",
    "\n",
    "# 优化后的任务2：处理知识点ID并创建新的dataframe，确保抽取的行对不重复\n",
    "def process_knowledge_points_unique(df, output_file, max_attempts=100):\n",
    "    # 获取知识点ID的唯一值\n",
    "    unique_knowledge_ids = df['知识点ID'].unique()\n",
    "    \n",
    "    # 创建一个空的dataframe用于存储结果\n",
    "    result_df = pd.DataFrame()\n",
    "    \n",
    "    # 对每个唯一的知识点ID处理\n",
    "    for kid in unique_knowledge_ids:\n",
    "        # 提取该知识点ID对应的所有行\n",
    "        subset = df[df['知识点ID'] == kid].reset_index()\n",
    "        \n",
    "        # 记录已使用的行对组合\n",
    "        used_pairs = set()\n",
    "        pairs_count = 0\n",
    "        attempts = 0\n",
    "        \n",
    "        # 每个知识点ID需要抽取4对不重复的行\n",
    "        while pairs_count < 20 and attempts < max_attempts:\n",
    "            attempts += 1\n",
    "            \n",
    "            # 确保子集至少有2行，如果不够，则使用有放回的抽样\n",
    "            if len(subset) < 2:\n",
    "                sample_indices = np.random.choice(len(subset), 2, replace=True)\n",
    "            else:\n",
    "                sample_indices = np.random.choice(len(subset), 2, replace=False)\n",
    "            \n",
    "            # 对索引排序以确保(1,2)和(2,1)被视为相同组合\n",
    "            pair = tuple(sorted(sample_indices))\n",
    "            \n",
    "            # 检查是否是新的组合\n",
    "            if pair not in used_pairs:\n",
    "                used_pairs.add(pair)\n",
    "                pairs_count += 1\n",
    "                \n",
    "                # 获取对应的行\n",
    "                row1 = subset.iloc[pair[0]].drop('index')\n",
    "                row2 = subset.iloc[pair[1]].drop('index')\n",
    "                \n",
    "                # 重命名列，添加后缀'-1'和'-2'\n",
    "                row1 = row1.rename(lambda x: f\"{x}-1\")\n",
    "                row2 = row2.rename(lambda x: f\"{x}-2\")\n",
    "                \n",
    "                # 合并两行成为一行\n",
    "                combined_row = pd.concat([row1, row2])\n",
    "                \n",
    "                # 将合并后的行添加到结果dataframe\n",
    "                result_df = pd.concat([result_df, pd.DataFrame([combined_row])], ignore_index=True)\n",
    "        \n",
    "        # 如果达到最大尝试次数但未获得足够的不重复对，输出警告\n",
    "        if pairs_count < 20:\n",
    "            print(f\"警告: 知识点ID {kid} 只能生成 {pairs_count} 个不重复的行对，少于要求的4个\")\n",
    "    \n",
    "    # 保存结果到新文件\n",
    "    result_df.to_excel(output_file, index=False)\n",
    "    \n",
    "    return result_df\n",
    "\n",
    "\n",
    "# 调用函数\n",
    "input_file = \"data/难度评测-v2.0.xlsx\"\n",
    "output_file1 = \"data/难度评测-v2.0_task1.xlsx\"\n",
    "output_file2 = \"data/难度评测-v2.0_task2.xlsx\"\n",
    "\n",
    "# 执行任务1\n",
    "processed_df = process_excel(input_file, output_file1)\n",
    "\n",
    "# 执行优化后的任务2\n",
    "result_df = process_knowledge_points_unique(processed_df, output_file2)\n",
    "\n",
    "print(f\"任务1完成，结果保存至: {output_file1}\")\n",
    "print(f\"优化后的任务2完成，结果保存至: {output_file2}\")"
   ]
