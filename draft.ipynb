    "    results = {'A': [], 'B': [], 'C': []}\n",
    "    knowledge_labels = []\n",
    "    \n",
    "    # 逐个知识点计算DOA\n",
    "    for kp in knowledge_points:\n",
    "        kp_df = df[df['知识点ID'] == kp]\n",
    "        knowledge_labels.append(str(kp))\n",
    "        \n",
    "        for diff_sys in ['A', 'B', 'C']:\n",
    "            doa = calculate_doa_pairwise(kp_df, diff_sys)\n",
    "            results[diff_sys].append(doa)\n",
    "    \n",
    "    # 计算不考虑知识点的整体DOA（全体题目）\n",
    "    overall_doa = {\n",
    "        'A': calculate_doa_pairwise(df, 'A'),\n",
    "        'B': calculate_doa_pairwise(df, 'B'),\n",
    "        'C': calculate_doa_pairwise(df, 'C')\n",
    "    }\n",
    "    \n",
    "    # 计算加权平均DOA（以记录数量为权重）\n",
    "    weighted_doa = {'A': 0, 'B': 0, 'C': 0}\n",
    "    total_records = df['记录数量'].sum()\n",
    "    \n",
    "    for kp in knowledge_points:\n",
    "        kp_df = df[df['知识点ID'] == kp]\n",
    "        kp_weight = kp_df['记录数量'].sum() / total_records\n",
    "        \n",
    "        for diff_sys in ['A', 'B', 'C']:\n",
    "            doa = calculate_doa_pairwise(kp_df, diff_sys)\n",
    "            if not np.isnan(doa):\n",
    "                weighted_doa[diff_sys] += doa * kp_weight\n",
    "    \n",
    "    # 绘制折线图\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    \n",
    "    colors = {'A': 'blue', 'B': 'red', 'C': 'green'}\n",
    "    markers = {'A': 'o', 'B': 's', 'C': '^'}\n",
    "    line_styles = {'A': '-', 'B': '-', 'C': '-'}\n",
    "    \n",
    "    for diff_sys in ['A', 'B', 'C']:\n",
    "        # 绘制知识点DOA折线\n",
    "        plt.plot(knowledge_labels, results[diff_sys], marker=markers[diff_sys], \n",
    "                 linestyle=line_styles[diff_sys], linewidth=2,\n",
    "                 label=f'难度体系{diff_sys}', color=colors[diff_sys])\n",
    "        \n",
    "        # 绘制整体DOA水平线\n",
    "        plt.axhline(y=overall_doa[diff_sys], color=colors[diff_sys], linestyle='--', linewidth=1.5,\n",
    "                   label=f'整体DOA {diff_sys}: {overall_doa[diff_sys]:.3f}')\n",
    "        \n",
    "        # 绘制加权平均DOA水平线\n",
    "        plt.axhline(y=weighted_doa[diff_sys], color=colors[diff_sys], linestyle=':', linewidth=1.5,\n",
    "                   label=f'加权平均DOA {diff_sys}: {weighted_doa[diff_sys]:.3f}')\n",
    "    \n",
    "    plt.xlabel('知识点ID', fontsize=14)\n",
    "    plt.ylabel('一致性程度 (DOA)', fontsize=14)\n",
    "    plt.title('各知识点在不同难度体系下的配对比较DOA', fontsize=16)\n",
    "    plt.legend(loc='best', fontsize=11)\n",
    "    plt.grid(True, linestyle='--', alpha=0.7)\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.yticks(np.arange(0, 1.1, 0.1))  # DOA范围为0-1\n",
    "    plt.ylim(0, 1.05)  # 设置y轴范围\n",
    "\n",
    "    # ========================================================添加图注文本========================================================\n",
    "    annotation_text = (\n",
    "        \"(1) 折线：特定知识点的DOA = 符合预期关系的配对数 / 总配对数，其中符合预期关系: \"\n",
    "        \"难度高的题目正确率低，即 难度(row1)>难度(row2) 且 正确率(row1)<正确率(row2)；\\n\\n\"\n",
    "        \"(2) 加权平均DOA：对所有的(1)，根据每个知识点的记录数量计算加权平均；\\n\\n\"\n",
    "        \"(3) 整体DOA：不区分知识点，直接对全量数据计算DOA\"\n",
    "    )\n",
    "\n",
    "    # 在左下角添加文本框\n",
    "    plt.figtext(0.01, 0.01, annotation_text, \n",
    "            bbox=dict(facecolor='white', alpha=0.8, edgecolor='gray', boxstyle='round'),\n",
    "            verticalalignment='bottom', \n",
    "            horizontalalignment='left',\n",
    "            fontsize=9, \n",
    "            wrap=True)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.subplots_adjust(bottom=0.3)  # 为底部的注释留出空间\n",
    "\n",
    "    # ====================================================plt.tight_layout()====================================================\n",
    "    \n",
    "    # 输出DOA结果\n",
    "    print(\"各难度体系整体DOA (不考虑知识点区分):\")\n",
    "    for diff_sys in ['A', 'B', 'C']:\n",
    "        print(f\"难度体系 {diff_sys}: {overall_doa[diff_sys]:.4f}\")\n",
    "    \n",
    "    print(\"\\n各难度体系加权平均DOA:\")\n",
    "    for diff_sys in ['A', 'B', 'C']:\n",
    "        print(f\"难度体系 {diff_sys}: {weighted_doa[diff_sys]:.4f}\")\n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    return results, overall_doa, weighted_doa\n",
    "\n",
