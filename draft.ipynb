    "import itertools\n",
    "\n",
    "def calculate_doa_pairwise(df, difficulty_col):\n",
    "    \"\"\"\n",
    "    计算DOA (Degree of Agreement) 使用配对比较法\n",
    "    DOA = 符合预期关系的配对数 / 总配对数\n",
    "    符合预期关系: 难度高的题目正确率低，即 难度(row1)>难度(row2) 且 正确率(row1)<正确率(row2)\n",
    "    \"\"\"\n",
    "    rows = df.shape[0]\n",
    "    if rows <= 1:\n",
    "        return np.nan  # 数据不足，无法计算DOA\n",
    "    \n",
    "    # 获取所有可能的行配对\n",
    "    pairs = list(itertools.combinations(range(rows), 2))\n",
    "    total_pairs = len(pairs)\n",
    "    \n",
    "    # 计数符合预期关系的配对\n",
    "    consistent_count = 0\n",
    "    for i, j in pairs:\n",
    "        # 检查难度和正确率的关系是否一致\n",
    "        if (df.iloc[i][difficulty_col] > df.iloc[j][difficulty_col] and \n",
    "            df.iloc[i]['平均正确率'] < df.iloc[j]['平均正确率']):\n",
    "            consistent_count += 1\n",
    "        elif (df.iloc[i][difficulty_col] < df.iloc[j][difficulty_col] and \n",
    "              df.iloc[i]['平均正确率'] > df.iloc[j]['平均正确率']):\n",
    "            consistent_count += 1\n",
    "    \n",
    "    # DOA = 符合预期关系的配对数 / 总配对数\n",
    "    return consistent_count / total_pairs\n",
    "\n",
    "def analyze_and_plot_doa(df):\n",
    "    # 解决中文显示问题\n",
    "    plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'SimSun', 'Arial Unicode MS', 'DejaVu Sans']\n",
    "    plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题\n",
    "    \n",
    "    # 获取所有唯一的知识点ID\n",
    "    knowledge_points = sorted(df['知识点ID'].unique())\n",
