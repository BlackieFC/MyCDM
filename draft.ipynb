   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from itertools import combinations\n",
    "\n",
    "\n",
    "# 任务1\n",
    "def process_excel_file(input_file, output_file, sheet_name='diff-v2'):\n",
    "    \"\"\"\n",
    "    pandas读取xlsx中的表\"sss\"，\n",
    "    新增列D，内容为C列中小于0.4的值+0.1，其余不变；\n",
    "    新增列E，内容为B列的值乘以0.2；将修改后的dataframe保存至新的xlsx文件中；\n",
    "    \"\"\"\n",
    "    # 读取xlsx中的表\"sss\"\n",
    "    df = pd.read_excel(input_file, sheet_name=sheet_name)\n",
    "    \n",
    "    # 新增列D，内容为C列中小于0.4的值+0.1，其余不变\n",
    "    df['D'] = df['C'].apply(lambda x: x + 0.1 if x < 0.4 else x)\n",
    "    \n",
    "    # 新增列E，内容为B列的值乘以0.2\n",
    "    df['E'] = df['B'] * 0.2\n",
    "    \n",
    "    # 保存修改后的dataframe至新的xlsx文件\n",
    "    df.to_excel(output_file, index=False)\n",
    "    \n",
    "    return df\n",
    "\n",
    "# 任务2\n",
    "def create_paired_samples(df):\n",
    "    \"\"\"\n",
    "    在（1）的基础上，统计dataframe的列“知识点ID”的unique值，\n",
    "    随后对于每个unique值，拆出对应行组成的子dataframe，并随机抽取其中2行，\n",
    "    将两行并作一行（相同的列名添加后缀'-1'和'-2'），保存至新的dataframe B中，\n",
    "    以此类推，每个unique值抽4次，均保存至B中。\n",
    "    \"\"\"\n",
    "    # 1. 获取\"知识点ID\"列的unique值\n",
    "    unique_ids = df[\"知识点ID\"].unique()\n",
    "\n",
    "    # 2. 创建新的空dataframe B，用于保存结果\n",
    "    B = pd.DataFrame()\n",
    "\n",
    "    # 3. 标识计数初始化\n",
    "    counter = 0\n",
    "\n",
    "    # 4. 对于每个唯一的知识点ID\n",
    "    for id_value in unique_ids:\n",
    "        # 获取当前知识点ID对应的所有行\n",
    "        sub_df = df[df[\"知识点ID\"] == id_value].copy()\n",
    "        \n",
    "        # 确保子dataframe至少有2行数据可供抽样\n",
    "        if len(sub_df) >= 2:\n",
    "            # 计算理论上可能的最大不重复组合数\n",
    "            max_possible_combinations = len(list(combinations(range(len(sub_df)), 2)))\n",
    "            \n",
    "            # 要抽取的对数，取4与最大可能组合数的较小值\n",
    "            pairs_to_extract = min(4, max_possible_combinations)\n",
    "            \n",
    "            # 用于记录已抽取的行索引组合\n",
    "            extracted_pairs = set()\n",
    "            \n",
    "            # 抽取指定数量的不重复对\n",
    "            pairs_count = 0\n",
    "            max_attempts = 100  # 设置最大尝试次数，防止无限循环\n",
    "            \n",
    "            while pairs_count < pairs_to_extract and max_attempts > 0:\n",
    "                # 随机抽取2行\n",
    "                sampled_rows = sub_df.sample(n=2)\n",
    "                \n",
    "                # 获取这两行在原子dataframe中的索引\n",
    "                indices = tuple(sorted(sampled_rows.index.tolist()))\n",
    "                \n",
    "                # 检查是否已经抽取过这个组合\n",
    "                if indices not in extracted_pairs:\n",
    "                    # 添加到已抽取集合中\n",
    "                    extracted_pairs.add(indices)\n",
    "                    \n",
    "                    # 添加标识列\n",
    "                    sampled_rows[\"标识\"] = counter\n",
    "                    \n",
    "                    # 将抽样结果添加到B中\n",
    "                    B = pd.concat([B, sampled_rows], ignore_index=True)\n",
    "                    \n",
    "                    # 标识计数器加1\n",
    "                    counter += 1\n",
    "                    \n",
    "                    # 已成功抽取的对数加1\n",
    "                    pairs_count += 1\n",
    "                \n",
    "                max_attempts -= 1\n",
    "                \n",
    "            # 如果尝试次数用完但仍未抽够，记录警告信息\n",
    "            if pairs_count < pairs_to_extract:\n",
    "                print(f\"警告：知识点ID {id_value} 无法抽取到 {pairs_to_extract} 个不重复对，已抽取 {pairs_count} 个。\")\n",
    "\n",
    "    # 现在B包含了所有抽样结果，每个知识点ID最多抽了4次不重复的对，每次2行，带有连续的标识\n",
    "    \n",
    "    return B\n",
    "\n",
    "\n",
    "# 调用函数，执行\n",
    "input_file = \"data/难度评测-v2.0.xlsx\"\n",
    "output_file_1 = \"data/难度评测-v2.0_task1.xlsx\"\n",
    "output_file_2 = \"data/难度评测-v2.0_task2.xlsx\"\n",
    "\n",
    "# 执行任务1\n",
    "processed_df = process_excel_file(input_file, output_file_1)\n",
    "\n",
    "# 执行任务2\n",
    "paired_df = create_paired_samples(processed_df)\n",
    "\n",
    "# 保存任务2的结果\n",
    "paired_df.to_excel(output_file_2, index=False)"
   ]
  },
