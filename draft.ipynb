    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import itertools\n",
    "\n",
    "\n",
    "def compute_partial_order_relation(df_in, col1, col2, thres=0.22):\n",
    "    \"\"\"\n",
    "    计算DataFrame中A列和B列之间的偏序关系\n",
    "    \n",
    "    规则:\n",
    "    1. 分母为参与统计的行数\n",
    "    2. 分子计数规则:\n",
    "        - 若A*B > 0则计数加1\n",
    "        - 若B=0则计数加max(0, 1-abs(A))\n",
    "    \"\"\"\n",
    "    # 参与统计的总行数（分母）\n",
    "    total_rows = len(df_in)\n",
    "    # 计算分子\n",
    "    count = 0\n",
    "    for _, row in df_in.iterrows():\n",
    "        A, B = row[col1], row[col2]\n",
    "        \n",
    "        if A * B > 0:  # A和B同号且都不为0\n",
    "            # （1）阶跃边界\n",
    "            if abs(A)>thres:\n",
    "                count += 1\n",
    "            # # （2）线性过渡\n",
    "            # count += min(1, abs(A)/thres)\n",
    "            # # （3）二次过渡\n",
    "            # count += min(1, (abs(A)-thres/thres)**2)\n",
    "        elif B == 0:   # B为0的情况（难度差距<thres时计入）\n",
    "            # （1）阶跃边界\n",
    "            if abs(A)<=thres:\n",
    "                count += 1\n",
    "            # # （2）线性过渡\n",
    "            # count += max(0, 1 - abs(A)/thres)\n",
    "            # # （3）二次过渡\n",
    "            # count += max(0, 1-((abs(A)-thres)/thres)**2)\n",
    "    # 计算结果\n",
    "    result = count / total_rows if total_rows > 0 else 0\n",
    "    \n",
    "    return result\n",
    "\n",
    "\n",
    "def analyze_and_plot_doa(df):\n",
    "    # 解决中文显示问题\n",
    "    plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'SimSun', 'Arial Unicode MS', 'DejaVu Sans']\n",
    "    plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题\n",
    "    \n",
    "    # 获取所有唯一的知识点ID\n",
    "    knowledge_points = sorted(df['知识点ID'].unique())\n",
    "    \n",
    "    # 初始化结果存储字典\n",
    "    results = {'A_diff': [], 'B_diff': [], 'C_diff': []}\n",
    "    knowledge_labels = []\n",
    "    \n",
    "    # 逐个知识点计算DOA\n",
    "    for kp in knowledge_points:\n",
    "        # 提取出特定KC的子df\n",
    "        kp_df = df[df['知识点ID'] == kp]\n",
    "        knowledge_labels.append(str(kp))\n",
    "        \n",
    "        for diff_sys in ['A_diff', 'B_diff', 'C_diff']:\n",
    "            doa = compute_partial_order_relation(kp_df, diff_sys, '更难 (1,2,一样)')\n",
    "            results[diff_sys].append(doa)  # 保证同序\n",
    "    \n",
    "    # 计算不考虑知识点的整体DOA（全体题目）\n",
    "    overall_doa = {\n",
    "        'A_diff': compute_partial_order_relation(df, 'A_diff', '更难 (1,2,一样)'),\n",
    "        'B_diff': compute_partial_order_relation(df, 'B_diff', '更难 (1,2,一样)'),\n",
    "        'C_diff': compute_partial_order_relation(df, 'C_diff', '更难 (1,2,一样)')\n",
    "    }\n",
    "    \n",
    "    # 绘制折线图\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    \n",
    "    colors = {'A_diff': 'blue', 'B_diff': 'red', 'C_diff': 'green'}\n",
    "    markers = {'A_diff': 'o', 'B_diff': 's', 'C_diff': '^'}\n",
    "    line_styles = {'A_diff': '-', 'B_diff': '-', 'C_diff': '-'}\n",
    "    \n",
    "    for diff_sys in ['A_diff', 'B_diff', 'C_diff']:\n",
    "        # 绘制知识点DOA折线\n",
    "        plt.plot(knowledge_labels, results[diff_sys], marker=markers[diff_sys], \n",
    "                 linestyle=line_styles[diff_sys], linewidth=2,\n",
    "                 label=f'难度体系{diff_sys}', color=colors[diff_sys])\n",
    "        \n",
    "        # 绘制整体DOA水平线\n",
    "        plt.axhline(y=overall_doa[diff_sys], color=colors[diff_sys], linestyle='--', linewidth=1.5,\n",
    "                   label=f'整体DOA {diff_sys}: {overall_doa[diff_sys]:.3f}')\n",
    "    \n",
    "    plt.xlabel('知识点ID', fontsize=14)\n",
    "    plt.ylabel('一致性程度 (DOA)', fontsize=14)\n",
    "    plt.title('各知识点在不同难度体系下的配对比较DOA', fontsize=16)\n",
    "    plt.legend(loc='best', fontsize=11)\n",
    "    plt.grid(True, linestyle='--', alpha=0.7)\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.yticks(np.arange(0, 1.1, 0.1))  # DOA范围为0-1\n",
    "    plt.ylim(0, 1.05)  # 设置y轴范围\n",
    "\n",
    "    # ========================================================添加图注文本========================================================\n",
    "    # annotation_text = (\n",
    "    #     \"(1) 折线：特定知识点的DOA = 符合预期关系的配对数 / 总配对数，其中符合预期关系: \"\n",
    "    #     \"难度高的题目正确率低，即 难度(row1)>难度(row2) 且 正确率(row1)<正确率(row2)；\\n\\n\"\n",
    "    #     \"(2) 加权平均DOA：对所有的(1)，根据每个知识点的记录数量计算加权平均；\\n\\n\"\n",
    "    #     \"(3) 整体DOA：不区分知识点，直接对全量数据计算DOA\"\n",
    "    # )\n",
    "\n",
    "    # # 在左下角添加文本框\n",
    "    # plt.figtext(0.01, 0.01, annotation_text, \n",
    "    #         bbox=dict(facecolor='white', alpha=0.8, edgecolor='gray', boxstyle='round'),\n",
    "    #         verticalalignment='bottom', \n",
    "    #         horizontalalignment='left',\n",
    "    #         fontsize=9, \n",
    "    #         wrap=True)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    # plt.subplots_adjust(bottom=0.3)  # 为底部的注释留出空间\n",
    "\n",
    "    # ====================================================plt.tight_layout()====================================================\n",
    "    \n",
    "    # 输出DOA结果\n",
    "    print(\"各难度体系整体DOA (不考虑知识点区分):\")\n",
    "    for diff_sys in ['A_diff', 'B_diff', 'C_diff']:\n",
    "        print(f\"难度体系 {diff_sys}: {overall_doa[diff_sys]:.4f}\")\n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    return results, overall_doa\n",
    "\n",
    "\n",
    "def gridsearch(df, param_range=np.linspace(0,0.5,26)):\n",
    "    # 解决中文显示问题\n",
    "    plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'SimSun', 'Arial Unicode MS', 'DejaVu Sans']\n",
    "    plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题\n",
    "    \n",
    "    # 获取所有唯一的知识点ID\n",
    "    knowledge_points = sorted(df['知识点ID'].unique())\n",
    "    \n",
    "    # 初始化结果存储字典\n",
    "    results = {'A_diff': [], 'B_diff': [], 'C_diff': []}\n",
    "    knowledge_labels = list(param_range)\n",
    "    \n",
    "    # 计算不考虑知识点的整体DOA（全体题目）\n",
    "    for threshold in knowledge_labels:\n",
    "        results['A_diff'].append(compute_partial_order_relation(df, 'A_diff', '更难 (1,2,一样)', thres=threshold))\n",
    "        results['B_diff'].append(compute_partial_order_relation(df, 'B_diff', '更难 (1,2,一样)', thres=threshold))\n",
    "        results['C_diff'].append(compute_partial_order_relation(df, 'C_diff', '更难 (1,2,一样)', thres=threshold))\n",
    "    \n",
    "    # 绘制折线图\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    \n",
    "    colors = {'A_diff': 'blue', 'B_diff': 'red', 'C_diff': 'green'}\n",
    "    markers = {'A_diff': 'o', 'B_diff': 's', 'C_diff': '^'}\n",
    "    line_styles = {'A_diff': '-', 'B_diff': '-', 'C_diff': '-'}\n",
    "    \n",
    "    for diff_sys in ['A_diff', 'B_diff', 'C_diff']:\n",
    "        # 绘制知识点DOA折线\n",
    "        plt.plot(knowledge_labels, results[diff_sys], marker=markers[diff_sys], \n",
    "                 linestyle=line_styles[diff_sys], linewidth=2,\n",
    "                 label=f'难度体系{diff_sys}', color=colors[diff_sys])\n",
    "    \n",
    "    plt.xlabel('知识点ID', fontsize=14)\n",
    "    plt.ylabel('一致性程度 (DOA)', fontsize=14)\n",
    "    plt.title('各知识点在不同难度体系下的配对比较DOA', fontsize=16)\n",
    "    plt.legend(loc='best', fontsize=11)\n",
    "    plt.grid(True, linestyle='--', alpha=0.7)\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.yticks(np.arange(0, 1.1, 0.1))  # DOA范围为0-1\n",
    "    plt.ylim(0, 1.05)  # 设置y轴范围\n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    return results, overall_doa\n",
    "\n",
    "\n",
    "# 使用方法\n",
    "results, overall_doa = analyze_and_plot_doa(df)\n",
    "results, overall_doa = gridsearch(df)\n",
    "\n",
    "df_filtered = df[df['更难 (1,2,一样)'] != 0]\n",
    "results, overall_doa = analyze_and_plot_doa(df_filtered)\n",
    "# results, overall_doa = gridsearch(df_filtered)\n",
    "\n",
    "df_filtered = df[df['更难 (1,2,一样)'] == 0]\n",
    "results, overall_doa = analyze_and_plot_doa(df_filtered)\n",
    "# results, overall_doa = gridsearch(df_filtered)\n"
   ]
