    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import pearsonr\n",
    "import matplotlib as mpl\n",
    "from matplotlib.font_manager import FontProperties\n",
    "\n",
    "def calculate_doa(df, difficulty_col):\n",
    "    \"\"\"计算DOA (Degree of Agreement)，使用Pearson相关系数的负值\"\"\"\n",
    "    # 难度与正确率应该是负相关的，所以取负值使DOA为正值表示好的一致性\n",
    "    corr, _ = pearsonr(df[difficulty_col], df['平均正确率'])\n",
    "    return -corr  # 取负值，使得DOA值越高表示一致性越好\n",
    "\n",
    "def calculate_weighted_doa(df, difficulty_col):\n",
    "    \"\"\"计算加权DOA，使用记录数量作为权重\"\"\"\n",
    "    # 按题目分组计算加权平均\n",
    "    total_records = df['记录数量'].sum()\n",
    "    weighted_corr = 0\n",
    "    \n",
    "    for _, group in df.groupby('题目id'):\n",
    "        weight = group['记录数量'].sum() / total_records\n",
    "        if len(group) > 1:  # 需要至少2个数据点计算相关系数\n",
    "            corr, _ = pearsonr(group[difficulty_col], group['平均正确率'])\n",
    "            weighted_corr += (-corr) * weight\n",
    "    \n",
    "    return weighted_corr\n",
    "\n",
    "def analyze_and_plot_doa(df):\n",
    "    # 设置中文字体支持 - 方法1：使用系统中的中文字体\n",
    "    plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'SimSun', 'Arial Unicode MS', 'DejaVu Sans']  # 优先使用的字体列表\n",
    "    plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题\n",
    "\n",
    "    # 获取所有唯一的知识点ID\n",
    "    knowledge_points = df['知识点ID'].unique()\n",
    "    \n",
    "    # 准备存储结果的数据结构\n",
    "    results = {\n",
    "        'A': [],\n",
    "        'B': [],\n",
    "        'C': []\n",
    "    }\n",
    "    knowledge_labels = []\n",
    "    \n",
    "    # 计算每个知识点的DOA\n",
    "    for kp in knowledge_points:\n",
    "        kp_df = df[df['知识点ID'] == kp]\n",
    "        knowledge_labels.append(str(kp))\n",
    "        \n",
    "        for diff_sys in ['A', 'B', 'C']:\n",
    "            doa = calculate_doa(kp_df, diff_sys)\n",
    "            results[diff_sys].append(doa)\n",
    "    \n",
    "    # 计算整体的DOA（不考虑知识点）\n",
    "    overall_doa = {\n",
    "        'A': calculate_doa(df, 'A'),\n",
    "        'B': calculate_doa(df, 'B'),\n",
    "        'C': calculate_doa(df, 'C')\n",
    "    }\n",
    "    \n",
    "    # 计算加权平均DOA\n",
    "    weighted_doa = {\n",
    "        'A': calculate_weighted_doa(df, 'A'),\n",
    "        'B': calculate_weighted_doa(df, 'B'),\n",
    "        'C': calculate_weighted_doa(df, 'C')\n",
    "    }\n",
    "    \n",
    "    # 绘制折线图\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    \n",
    "    colors = {'A': 'blue', 'B': 'red', 'C': 'green'}\n",
    "    markers = {'A': 'o', 'B': 's', 'C': '^'}\n",
    "    \n",
    "    for diff_sys in ['A', 'B', 'C']:\n",
    "        plt.plot(knowledge_labels, results[diff_sys], marker=markers[diff_sys], \n",
    "                 label=f'难度体系{diff_sys}', color=colors[diff_sys])\n",
    "        \n",
    "        # 在图上标记整体DOA\n",
    "        plt.axhline(y=overall_doa[diff_sys], color=colors[diff_sys], linestyle='--',\n",
    "                   label=f'整体DOA {diff_sys}: {overall_doa[diff_sys]:.3f}')\n",
    "        \n",
    "        # 在图上标记加权平均DOA\n",
    "        plt.axhline(y=weighted_doa[diff_sys], color=colors[diff_sys], linestyle=':',\n",
